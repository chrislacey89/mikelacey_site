---
import StorySection from '../components/story/Story.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadQuery } from '../lib/loadQuery';
import { PRODUCTION_ORIGIN } from '../utils/canonical';
import { buildPageGraph } from '../utils/jsonld';
import { isPreviewRequest } from '../utils/preview';
import { findSitePage } from '../utils/site-pages';

const page = findSitePage('/story')!;

// Detect preview mode from URL (Sanity Presentation tool)
const preview = isPreviewRequest(Astro.url);

// Fetch timeline events and page content from Sanity
const [timelineEvents, pageContent] = await Promise.all([
  loadQuery<any[]>({
    preview,
    query: `
      *[_type == "timelineEvent"] | order(orderRank asc, _createdAt asc) {
        "id": _id,
        year,
        showYear,
        title,
        narrative,
        "photo": photo.asset->url
      }
    `,
  }),
  loadQuery<any>({
    preview,
    query: `*[_type == "siteSettings"][0].storyPage`,
  }),
]);

// AboutPage rather than WebPage: the page's subject is the Person the homepage
// defines, referenced by @id rather than redescribed here.
const jsonLd = buildPageGraph(
  {
    path: page.path,
    name: page.title,
    description: page.description,
    type: 'AboutPage',
    breadcrumbLabel: page.navLabel,
  },
  Astro.site?.origin ?? PRODUCTION_ORIGIN,
);
---

<BaseLayout title={page.title} description={page.description} jsonLd={jsonLd}>
  <StorySection timelineEvents={timelineEvents} pageContent={pageContent} />
</BaseLayout>

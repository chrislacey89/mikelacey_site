---
import { loadQuery } from '../lib/loadQuery';
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import { PRODUCTION_ORIGIN } from '../utils/canonical';
import { buildHomeGraph } from '../utils/jsonld';
import type { CTA } from '../types';

// Detect preview mode from URL (Sanity Presentation tool)
const preview = Astro.url.searchParams.has('preview') || Astro.url.searchParams.has('sanity-preview');

// Fetch site settings from Sanity
const settings = await loadQuery<any>({
  preview,
  query: `
    *[_type == "siteSettings"][0] {
      hero {
        "backgroundImage": backgroundImage.asset->url,
        headline,
        tagline
      },
      profile {
        name,
        title,
        "headshotImage": headshotImage.asset->url,
        subtitle
      },
      ctas[] {
        "id": _key,
        label,
        href,
        variant
      },
      contactInfo {
        linkedin,
        imdb
      }
    }
  `
});

const ctas: CTA[] = (settings?.ctas || []).map((cta: { id: string; label: string; href: string; variant: string }) => {
  if (cta.variant !== 'primary' && cta.variant !== 'secondary') {
    throw new Error(`Invalid CTA variant: ${cta.variant}`);
  }
  return {
    ...cta,
    variant: cta.variant as 'primary' | 'secondary',
  };
});

// Always the canonical production origin, never Astro.url or the VERCEL_URL
// fallback BaseLayout uses for OG images. @id values are entity identifiers —
// a preview deploy must not assert a Mike Lacey that lives at a preview URL.
//
// The query above deliberately keeps stega enabled: it also feeds HomeHero,
// where stega powers click-to-edit. buildHomeGraph calls stegaClean on its own
// input instead, so the structured data stays clean without disabling visual
// editing for the hero.
const siteOrigin = Astro.site?.origin ?? PRODUCTION_ORIGIN;
const jsonLd = buildHomeGraph(
  {
    profile: settings?.profile,
    hero: settings?.hero,
    contactInfo: settings?.contactInfo,
  },
  siteOrigin
);
---

<BaseLayout
  title="Mike Lacey - Television Director"
  description="Television director Mike Lacey has spent four decades in live sports and entertainment, from a New York shipping department to directing PGA Tour golf."
  jsonLd={jsonLd}
>
  <HomeHero
    hero={settings?.hero}
    profile={settings?.profile}
    ctas={ctas}
  />
</BaseLayout>

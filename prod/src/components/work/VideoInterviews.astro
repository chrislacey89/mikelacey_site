---
import type { Interview } from '../../types';
import { extractYouTubeId } from './youtube';

interface Props {
  interviews: Interview[];
}

const { interviews } = Astro.props;
---

<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
  {interviews.map((interview) => {
    const isYouTube = interview.videoType === 'youtube' || (!interview.videoType && interview.youtubeUrl);
    const videoId = isYouTube ? extractYouTubeId(interview.youtubeUrl) : undefined;
    return (
      <div class="space-y-4">
        <div class="aspect-video rounded-lg overflow-hidden bg-stone-900 relative">
          {isYouTube && videoId ? (
            /* Click-to-load facade, not a live iframe. A real player pulls in
               YouTube's own chrome — including a channel-avatar button with
               no accessible name and a disallowed ARIA attribute that we
               cannot fix from our markup — and ships that JS whether or not
               anyone presses play. Rendering a thumbnail plus our own
               labeled button means zero player bytes load until a visitor
               actually asks to watch, and the only control on the page
               before then is one we control the accessibility of. */
            <div
              class="absolute inset-0"
              data-youtube-facade
              data-video-id={videoId}
              data-title={interview.title}
            >
              {/* mq and hq only: YouTube generates both for every video, but
                  sddefault and maxres exist only for higher-resolution
                  uploads — offered in a srcset, a 3x phone would pick them
                  and could get a 404 placeholder instead of a thumbnail. */}
              <img
                src={`https://i.ytimg.com/vi/${videoId}/hqdefault.jpg`}
                srcset={`https://i.ytimg.com/vi/${videoId}/mqdefault.jpg 320w, https://i.ytimg.com/vi/${videoId}/hqdefault.jpg 480w`}
                sizes="(min-width: 1024px) 528px, 100vw"
                alt=""
                width="480"
                height="360"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover"
              />
              <button
                type="button"
                class="absolute inset-0 flex w-full h-full items-center justify-center bg-black/20 transition-colors hover:bg-black/30 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset"
                aria-label={`Play video: ${interview.title}`}
                data-youtube-play
              >
                <svg
                  class="h-16 w-16 text-white drop-shadow-lg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M8 5v14l11-7z" />
                </svg>
              </button>
            </div>
          ) : isYouTube ? (
            // The authored URL didn't match any known YouTube shape (see
            // youtube.ts). Rendering an embed here would ship a player with
            // a blank ID that silently fails; a plain link at least gets a
            // visitor to the video.
            interview.youtubeUrl ? (
              <a
                href={interview.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-full w-full items-center justify-center bg-stone-900 text-white underline focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-inset"
              >
                Watch on YouTube
              </a>
            ) : null
          ) : (
            <video
              src={interview.directVideoUrl}
              title={interview.title}
              controls
              class="w-full h-full object-contain"
              preload="metadata"
            >
              Your browser does not support the video tag.
            </video>
          )}
        </div>
        <div>
          <h3 class="font-semibold text-stone-900 dark:text-white">
            {interview.title}
          </h3>
          <p class="text-sm text-stone-600 dark:text-stone-400">
            {interview.description}
          </p>
        </div>
      </div>
    );
  })}
</div>

<script>
  // Event delegation on the document, not a per-card listener: one script
  // handles every interview's facade, so it costs nothing extra as the
  // list grows and keeps working if cards are added after this script runs.
  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const button = target.closest('[data-youtube-play]');
    if (!(button instanceof HTMLButtonElement)) return;

    const facade = button.closest('[data-youtube-facade]');
    if (!(facade instanceof HTMLElement)) return;

    const videoId = facade.dataset.videoId;
    if (!videoId) return;

    // Autoplay on the swapped-in iframe: the click is the visitor's request
    // to watch, so requiring a second press inside the embed would be a
    // regression from what the facade replaced.
    const iframe = document.createElement('iframe');
    iframe.src = `https://www.youtube-nocookie.com/embed/${videoId}?autoplay=1`;
    iframe.title = facade.dataset.title ?? '';
    iframe.allow =
      'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    iframe.allowFullscreen = true;
    iframe.referrerPolicy = 'strict-origin-when-cross-origin';
    iframe.className = 'w-full h-full';

    facade.replaceWith(iframe);
    // The facade (and its button) is gone; move focus to the thing that
    // replaced it so a keyboard user isn't left on a detached node.
    iframe.focus();
  });
</script>
